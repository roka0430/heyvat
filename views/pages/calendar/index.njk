{% extends "layouts/base.njk" %}

{% set pageId = "calendar" %}

{% block styles %}
  <link rel="stylesheet" href="/css/calendar.css" />
{% endblock %}

{% block title %}
  Heyvat | Calendar
{% endblock %}

{% block content %}
  <main class="app-main">
    <h2 class="app-main__page-title">カレンダー</h2>
    <div class="calendar" x-data="calendar">
      <div class="calendar__header">
        <div class="calendar__year-month">
          <span x-text="year"></span>年
          <span x-text="month"></span>月
        </div>
        <div class="calendar__actions">
          <button @click="changeMonth(-1)">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-chevron-left preview-icon">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button @click="goToToday()">今日</button>
          <button @click="changeMonth(1)">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-chevron-right preview-icon">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </div>
      <div class="calendar__body">
        <div class="calendar__weekdays">
          <template x-for="weekday in weekdays" :key="weekday.value">
            <div class="calendar__weekday" x-text="weekday.weekday"></div>
          </template>
        </div>
        <div class="calendar__days">
          <template x-for="cell in cells" :key="cell.key">
            <div class="calendar__day" x-text="cell.date"></div>
          </template>
        </div>
      </div>
    </div>
  </main>
{% endblock %}

{% block scripts %}
  <script src="/js/calendar.js" defer></script>
{% endblock %}
