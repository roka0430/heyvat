{% extends "layouts/base.njk" %}

{% set pageId = "dashboard" %}

{% block styles %}
  <link rel="stylesheet" href="/css/dashboard.css" />
{% endblock %}

{% block title %}
  Heyvat
{% endblock %}

{% block content %}
  <main class="app-main">
    <h2 class="app-main__page-title">ダッシュボード</h2>
    <div class="dashboard">
      <section class="dashboard__user dashboard-user" x-data="user">
        <div
          class="dashboard-user__card"
          :style="`--name-card-url: url('${userInfo.nameCardUrl ?? ''}');`">
          <div class="dashboard-user__basic-info">
            <div class="dashboard-user__icon">
              <img
                alt="icon"
                :src="userInfo.iconUrl"
                width="80"
                height="80"
              />
            </div>
            <div class="dashboard-user__nickname" x-text="userInfo.nickname">
            </div>
            <div class="dashboard-user__rank">
              <span x-text="`AR${userInfo.level}`"></span>
              <span x-text="`WL${userInfo.worldLevel}`"></span>
            </div>
            <div class="dashboard-user__signature" x-text="userInfo.signature">
            </div>
          </div>
          <div class="dashboard-user__records">
            <div class="dashboard-user__record dashboard-user__achievement">
              <img
                src="https://enka.network/img/achievements.png"
                class="dashboard-user__record-icon"
                width="20"
                height="20"
              />
              <div class="dashboard-user__record-content">
                <span x-text="userInfo.finishAchievementNum"></span>
              </div>
            </div>
            <div class="dashboard-user__record dashboard-user__tower">
              <img
                src="https://enka.network/img/abyss.png"
                class="dashboard-user__record-icon"
                width="20"
                height="20"
              />
              <div class="dashboard-user__record-content">
                <span x-text="userInfo.towerFloorIndex"></span>
                <span>-</span>
                <span x-text="userInfo.towerLevelIndex"></span>
                <span>/</span>
                <span x-text="userInfo.towerStarIndex"></span>
              </div>
            </div>
            <div class="dashboard-user__record dashboard-user__theater">
              <img
                src="https://enka.network/ui/UI_Icon_Tower_Star1.png"
                class="dashboard-user__record-icon"
                width="20"
                height="20"
              />
              <div class="dashboard-user__record-content">
                <span x-text="userInfo.theaterActIndex"></span>
                <span>/</span>
                <span x-text="userInfo.theaterStarIndex"></span>
              </div>
            </div>
            <div class="dashboard-user__record dashboard-user__stygian">
              <img
                :src="`https://enka.network/ui/UI_LeyLineChallenge_Medal_${userInfo.stygianIndex}.png`"
                class="dashboard-user__record-icon"
                width="20"
                height="20"
              />
              <div class="dashboard-user__record-content">
                <span>N</span>
                <span x-text="userInfo.stygianIndex"></span>
                <span>/</span>
                <span x-text="userInfo.stygianSeconds"></span>
                <span>s</span>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="dashboard__events dashboard-events" x-data="events">
        <div class="dashboard-events__card">
          <h4>バージョン</h4>
          <div x-text="currentVersionName"></div>
          <div class="dashboard-events__next">まで16日</div>
        </div>
        <div class="dashboard-events__card">
          <h4>深境螺旋</h4>
          <div class="dashboard-events__next">まで16日</div>
        </div>
        <div class="dashboard-events__card">
          <h4>幻想シアター</h4>
          <div class="dashboard-events__next">まで16日</div>
        </div>
        <div class="dashboard-events__card">
          <h4>幽境の激戦</h4>
          <div class="dashboard-events__next">まで16日</div>
        </div>
        <div class="dashboard-events__card">
          <h4>card</h4>
          <div class="dashboard-events__next">まで16日</div>
        </div>
      </section>
    </div>
  </main>
{% endblock %}

{% block scripts %}
  <script src="/js/dashboard.js" defer></script>
{% endblock %}
