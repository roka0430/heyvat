{% extends "layouts/base.njk" %}

{% set pageId = "characters" %}

{% block styles %}
  <link rel="stylesheet" href="/css/characters.css" />
{% endblock %}

{% block title %}
  Heyvat | Characters
{% endblock %}

{% block content %}
  <main class="app-main">
    <h2 class="app-main__page-title">キャラクター</h2>
    <div class="characters">
      <div class="characters__list" x-data="charactersList">
        <div class="characters__item characters__item--head">
          <div class="characters__name">名前</div>
          <div class="characters__consts">命ノ星座</div>
          <div class="characters__weapon">武器</div>
          <div class="characters__sets">セット</div>
          <div class="characters__crit">CV</div>
        </div>
        <template x-for="character in characters" :key="character.id">
          <div class="characters__item">
            <div class="characters__name" x-text="character.name.ja"></div>
            <div
              class="characters__consts"
              :class="`characters__consts--consts${character.consts}`">
              <div :style="`--consts: ${character.consts};`">
                C<span x-text="character.consts"></span>
              </div>
            </div>
            <div class="characters__weapon">
              <img
                :src="character.weaponInfo.icon"
                alt="character.weaponInfo.name.en"
                width="25"
                height="25"
              />
              <div>
                R<span x-text="character.weaponInfo.refinement"></span>
              </div>
            </div>
            <div class="characters__sets">
              <template
                x-for="set in character.artifactSets"
                :key="set.name.en">
                <div>
                  <img
                    :src="set.icon"
                    alt="set.name.en"
                    width="25"
                    height="25"
                  />
                </div>
              </template>
            </div>
            <div class="characters__crit">
              <span x-text="Math.round(character.stats.cr * 1000) / 10"></span>
              : <span
                x-text="Math.round(character.stats.cd * 1000) / 10"></span>
              <span
                x-text="Number(character.scores[character.scoreReference]).toFixed(1)"></span>
            </div>
          </div>
        </template>
      </div>
    </div>
  </main>
{% endblock %}

{% block scripts %}
  <script src="/js/characters.js" defer></script>
{% endblock %}
