{% extends "layouts/base.njk" %}

{% set pageId = "characters" %}

{% block styles %}
  <link rel="stylesheet" href="/css/characters.css" />
{% endblock %}

{% block title %}
  Heyvat | Characters
{% endblock %}

{% block content %}
  <main class="app-main">
    <h2 class="app-main__page-title">キャラクター</h2>
    <div class="characters">
      <div class="characters__list" x-data="charactersList">
        <div class="characters__item characters__item--head">
          <div class="characters__name">名前</div>
          <div class="characters__consts">命ノ星座</div>
          <div class="characters__weapon">武器</div>
          <div class="characters__sets">聖遺物</div>
          <div class="characters__crit">会心</div>
          <div class="characters__score">
            <select x-model="referenceScore">
              <option value="recommendation">推奨スコア</option>
              <option value="crit">会心スコア</option>
              <option value="hp">HP換算</option>
              <option value="atk">攻撃換算</option>
              <option value="def">防御換算</option>
              <option value="er">元チャ換算</option>
              <option value="em">熟知換算</option>
            </select>
          </div>
        </div>
        <template x-for="character in characters" :key="character.id">
          <div class="characters__item">
            <div class="characters__name">
              <img
                :src="character.icon"
                alt="character.name.en"
                width="25"
                height="25"
              />
              <span x-text="character.name.ja"></span>
            </div>
            <div
              class="characters__consts"
              :class="`characters__consts--consts${character.consts}`">
              <div :style="`--consts: ${character.consts};`">
                C<span x-text="character.consts"></span>
              </div>
            </div>
            <div class="characters__weapon">
              <img
                :src="character.weaponInfo.icon"
                alt="character.weaponInfo.name.en"
                width="25"
                height="25"
              />
              <div>
                R<span x-text="character.weaponInfo.refinement"></span>
              </div>
            </div>
            <div class="characters__sets">
              <template
                x-for="set in character.artifactSets"
                :key="set.name.en">
                <div>
                  <img
                    :src="set.icon"
                    alt="set.name.en"
                    width="25"
                    height="25"
                  />
                  <span x-text="set.num"></span>
                </div>
              </template>
            </div>
            <div class="characters__crit">
              <span x-text="Math.round(character.stats.cr * 1000) / 10"></span>
              <span>:</span>
              <span x-text="Math.round(character.stats.cd * 1000) / 10"></span>
            </div>
            <div class="characters__score">
              <img
                :src="`/images/stats/${referenceScore === 'recommendation' ? character.scoreReference : referenceScore}.png`"
                alt="stats"
                width="20"
                height="20"
              />
              <span
                x-text="Number(character.scores[referenceScore === 'recommendation' ? character.scoreReference : referenceScore]).toFixed(1)"></span>
            </div>
          </div>
        </template>
      </div>
    </div>
  </main>
{% endblock %}

{% block scripts %}
  <script src="/js/characters.js" defer></script>
{% endblock %}
