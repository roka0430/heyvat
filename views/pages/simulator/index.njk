{% extends "layouts/base.njk" %}

{% set pageId = "simulator" %}

{% block styles %}
  <link rel="stylesheet" href="/css/simulator.css" />
{% endblock %}

{% block title %}
  Heyvat | Simulator
{% endblock %}

{% block content %}
  <main class="app-main">
    <h2 class="app-main__page-title">シミュレーター</h2>
    <div class="simulator" x-data="simulator">
      <section class="simulator__input">
        <label class="simulator__field">
          <span>目標数</span>
          <input
            type="number"
            x-model.number="inputs.target"
            @focus="$el.select()"
          />
        </label>
        <label class="simulator__field">
          <span>原石</span>
          <input
            type="number"
            x-model.number="inputs.primo"
            @focus="$el.select()"
          />
        </label>
        <label class="simulator__field">
          <span>紡がれた運命</span>
          <input
            type="number"
            x-model.number="inputs.fate"
            @focus="$el.select()"
          />
        </label>
        <label class="simulator__field">
          <span>スターライト</span>
          <input
            type="number"
            x-model.number="inputs.starlight"
            @focus="$el.select()"
          />
        </label>
        <label class="simulator__field">
          <span>天井カウント</span>
          <input
            type="number"
            x-model.number="inputs.pity"
            @focus="$el.select()"
          />
        </label>
        <label class="simulator__toggle">
          <span>前回すり抜け</span>
          <input type="checkbox" x-model.boolean="inputs.guaranteed" />
        </label>
        <button class="simulator__calc-button" @click="simulateWish()">
          計算
        </button>
      </section>
      <section class="simulator__output">
        <table>
          <thead>
            <tr>
              <th>バージョン</th>
              <th>終了日</th>
              <th>残り日数</th>
              <th>原石</th>
              <th>連数</th>
              <th>達成率</th>
            </tr>
          </thead>
          <tbody>
            <template x-for="output in outputs" :key="output.version">
              <tr>
                <td x-text="output.version"></td>
                <td x-text="output.end"></td>
                <td x-text="`${output.days}日`"></td>
                <td x-text="`${output.primo}原石`"></td>
                <td x-text="`${output.fate}連`"></td>
                <td
                  x-text="`${formatPercentage(output.probability)}%`"
                  :class="{ 'achieved': Math.round(output.probability * 100) >= 100 }">
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </section>
    </div>
  </main>
{% endblock %}

{% block scripts %}
  <script src="/js/simulator.js" defer></script>
{% endblock %}
