<header class="app-header" x-data="header">
  <div class="app-header__inner">
    <a class="app-header__brand" href="/">
      <img
        class="app-header__logo"
        src="/images/favicon.png"
        alt="logo"
        width="32"
        height="32"
      />
      <h1 class="app-header__title">Heyvat</h1>
    </a>
    <div class="app-header__spacer"></div>
    <div
      class="app-header__uid"
      @click="copyUid({{ uid }})"
      title="クリックでUIDをコピー">
      UID {{ uid }}
    </div>
  </div>
</header>
